+<?xml version="1.0" encoding="utf-8"?>
+<!-- `movable` makes MapKit render into a TextureView instead of a SurfaceView. A SurfaceView
+     punches a hole through the window, so the map kept showing through the translucent status
+     bar of screens opened on top of it (edge-to-edge, transparentModal). A TextureView is part
+     of the normal view hierarchy and is covered like any other view. -->
+<com.yandex.mapkit.mapview.MapView xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    app:movable="true" />
