{
    "build_abis": ["arm64-v8a", "armeabi-v7a"],
    "android_min_sdk_version": 24,
    "android_target_sdk_version": 34,
    "build_params": [
        "--android", "--build_java", "--build_shared_lib", "--enable_lto",
        "--cmake_generator=Ninja", "--parallel=4",
        "--skip_tests", "--skip_submodule_sync", "--no_telemetry",
        "--disable_ml_ops", "--disable_generation_ops",
        "--cmake_extra_defines", "onnxruntime_BUILD_UNIT_TESTS=OFF"
    ]
}
