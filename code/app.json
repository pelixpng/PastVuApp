{
  "expo": {
    "name": "PastVu",
    "slug": "PastVuApp",
    "version": "2.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["assets/*.png"],
    "locales": {
      "ru": "./locales/ru.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.pelixpng.PastVuApp",
      "buildNumber": "66",
      "appleTeamId": "989AHJ2KDZ",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.pelixpng.PastVuApp"]
      },
      "icon": "./assets/PastVu.icon",
      "infoPlist": {
        "EXDefaultScreenOrientationMask": "UIInterfaceOrientationMaskAll"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "${MAPS_API_KEY}"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pelixpng.PastVuApp",
      "versionCode": 42,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "e18d3b69-bdd0-4b43-a4e2-02847112f893"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2D61A0",
          "android": {
            "image": "./assets/splashAndroid.png",
            "resizeMode": "contain",
            "backgroundColor": "#2D61A0"
          },
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Мы запрашиваем доступ для сохранения изображений в вашу фотогалерею, чтобы вы могли добавлять загруженные фотографии для дальнейшего просмотра и использования.",
          "granularPermissions": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Доступ к геолокации позволяет нам показать на карте интересны фотографии рядом с вами."
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withMapMarkers",
      "./plugins/withReleaseSigning",
      "./plugins/withLintConfig",
      "./plugins/withMapsKeyPlaceholder",
      "expo-image",
      "expo-localization",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ru",
            "en"
          ],
          "allowDynamicLocaleChangesAndroid": true
        }
      ]
    ]
  }
}
