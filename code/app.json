{
  "expo": {
    "name": "PastVu",
    "slug": "PastVuApp",
    "version": "2.6.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/*.png"
    ],
    "locales": {
      "ru": "./locales/ru.json",
      "en": "./locales/en.json",
      "uk": "./locales/uk.json",
      "be": "./locales/be.json",
      "pl": "./locales/pl.json",
      "de": "./locales/de.json",
      "cs": "./locales/cs.json",
      "hu": "./locales/hu.json",
      "fi": "./locales/fi.json",
      "et": "./locales/et.json",
      "lv": "./locales/lv.json",
      "lt": "./locales/lt.json",
      "sr": "./locales/sr.json",
      "fr": "./locales/fr.json"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.pelixpng.PastVuApp",
      "buildNumber": "69",
      "appleTeamId": "989AHJ2KDZ",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pelixpng.PastVuApp"
        ]
      },
      "icon": "./assets/PastVu.icon",
      "infoPlist": {
        "EXDefaultScreenOrientationMask": "UIInterfaceOrientationMaskAll"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "${MAPS_API_KEY}"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pelixpng.PastVuApp",
      "versionCode": 46,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "e18d3b69-bdd0-4b43-a4e2-02847112f893"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "# React Native view managers of the Yandex map fork are looked up by name.\n-keep class com.yamaplite.** { *; }\n# MMKV and the app's own Expo modules are called from native/JSI code.\n-keep class com.margelo.** { *; }\n-keep class expo.modules.applocale.** { *; }\n-keep class expo.modules.screencapture.** { *; }\n# expo-camera is built from source with the barcode scanner disabled: its ML Kit\n# references stay in the bytecode but are never reached.\n-dontwarn com.google.mlkit.**"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2D61A0",
          "android": {
            "image": "./assets/splashAndroid.png",
            "resizeMode": "contain",
            "backgroundColor": "#2D61A0"
          },
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Мы запрашиваем доступ для сохранения изображений в вашу фотогалерею, чтобы вы могли добавлять загруженные фотографии для дальнейшего просмотра и использования.",
          "granularPermissions": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Доступ к камере нужен, чтобы снять это место сегодня и сравнить со старой фотографией.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Доступ к геолокации позволяет нам показать на карте интересные фотографии рядом с вами.",
          "motionUsagePermission": false
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withMapMarkers",
      "./plugins/withReleaseSigning",
      "./plugins/withLintConfig",
      "./plugins/withMapsKeyPlaceholder",
      "expo-image",
      "expo-localization",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ru",
            "en",
            "uk",
            "be",
            "pl",
            "de",
            "cs",
            "hu",
            "fi",
            "et",
            "lv",
            "lt",
            "sr",
            "fr"
          ],
          "allowDynamicLocaleChangesAndroid": true
        }
      ]
    ]
  }
}
