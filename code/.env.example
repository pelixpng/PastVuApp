# Google Maps key for Android. Must allow the signing certificate of the build:
# the release keystore for Play, the debug keystore for local builds.
GOOGLE_MAPS_API_KEY=
# LocationIQ key for place search.
PLACE_API_KEY=
# Optional. Maps Embed API + Street View Static API (metadata) key, HTTP-referrer restricted to
# https://pastvuapp.local. Without it the "see it today" button opens Google Maps instead.
STREET_VIEW_API_KEY=
# Optional. Yandex MapKit key (lite SDK); enables the Yandex Maps provider in settings.
YANDEX_MAPS_API_KEY=
