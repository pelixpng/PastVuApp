# Google Maps keys for Android, one per signing certificate, as a key must allow the certificate
# of the build: GOOGLE_MAPS_API_KEY for release and preview builds (the release keystore for Play),
# GOOGLE_MAPS_API_KEY_DEBUG for debug builds (the debug keystore). Read from the environment, which
# Expo CLI fills from this file; PASTVU_MAPS_API_KEY(_DEBUG) in ~/.gradle/gradle.properties wins.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_DEBUG=
# LocationIQ key for place search.
PLACE_API_KEY=
# Optional. Maps Embed API + Street View Static API (metadata) key, HTTP-referrer restricted to
# https://pastvuapp.local. Without it the "see it today" button opens Google Maps instead.
STREET_VIEW_API_KEY=
# Optional. Yandex MapKit key (lite SDK); enables the Yandex Maps provider in settings.
YANDEX_MAPS_API_KEY=
# Optional. Google Cloud Translation API keys for the "Translate with Google" buttons; without them
# the app offers no translation. One per platform, as a key restricted to an app is restricted to
# one kind: TRANSLATE_API_KEY to the iOS bundle id, TRANSLATE_API_KEY_ANDROID to the package and
# its signing certificates. Restrict both to the Cloud Translation API and cap the project's daily
# characters within the free allowance.
TRANSLATE_API_KEY=
TRANSLATE_API_KEY_ANDROID=
