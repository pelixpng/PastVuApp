{
  "name": "pastvuapp",
  "version": "2.10.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package && node scripts/trim-yamap-codegen.js"
  },
  "dependencies": {
    "@bacons/apple-targets": "^3.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@exterio/react-native-yamap-lite": "^1.0.3",
    "@miblanchard/react-native-slider": "^2.3.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "expo": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-splash-screen": "~58.0.12",
    "i18n-js": "^4.5.3",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-device-info": "^15.0.2",
    "react-native-edge-to-edge": "^1.8.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-native-zoom-toolkit": "5.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "babel-preset-expo": "~58.0.22",
    "eslint": "^8.46.0",
    "eslint-plugin-react": "^7.33.1",
    "expo-build-properties": "~58.0.11",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ],
        "exclude": [
          "@expo/dom-webview",
          "expo-keep-awake",
          "react-native-view-shot"
        ]
      },
      "apple": {
        "buildFromSource": [
          "expo-image"
        ],
        "exclude": [
          "@expo/dom-webview",
          "expo-keep-awake"
        ]
      }
    }
  }
}
